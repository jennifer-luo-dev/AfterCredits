// SQLite or PostgreSQL configuration is expected to be provided via env var
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           String   @id @db.Uuid
  name         String
  username     String   @unique
  passwordHash String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

/// Memory model stores user memories
model Memory {
  id          Int      @id @default(autoincrement())
  title       String
  date        DateTime
  location    String?
  description String?
  imagePaths  String[] @default([])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

/// Note model stores freeform notes
model Note {
  id      Int      @id @default(autoincrement())
  userId  String   @db.Uuid // the auth user id (from Supabase)
  message String
  date    DateTime @default(now())
}
